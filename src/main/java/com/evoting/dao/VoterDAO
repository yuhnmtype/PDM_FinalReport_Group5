package com.evoting.dao;

import com.evoting.entity.Voter;
import com.evoting.enums.VoterStatus;
import com.evoting.util.DatabaseConnection;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;
import java.util.Optional;

/**
 * Data Access Object for the VOTER table.
 * All queries use PreparedStatement — no string concatenation.
 */
public class VoterDAO {

    // ── INSERT ────────────────────────────────────────────────────────────────

    public boolean insert(Voter voter) throws SQLException {
        String sql = """
                INSERT INTO voter (national_id, full_name, email, status, created_at, updated_at)
                VALUES (?, ?, ?, ?, NOW(), NOW())
                """;
        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql, Statement.RETURN_GENERATED_KEYS)) {

            ps.setString(1, voter.getNationalId());
            ps.setString(2, voter.getFullName());
            ps.setString(3, voter.getEmail());
            ps.setString(4, voter.getStatus().name());

            int rows = ps.executeUpdate();

            // Retrieve auto-generated primary key
            try (ResultSet keys = ps.getGeneratedKeys()) {
                if (keys.next()) {
                    voter.setVoterId(keys.getInt(1));
                }
            }
            return rows > 0;
        }
    }

    // ── SELECT ────────────────────────────────────────────────────────────────

    public Optional<Voter> findById(int voterId) throws SQLException {
        String sql = "SELECT * FROM voter WHERE voter_id = ?";
        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, voterId);
            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    return Optional.of(mapRow(rs));
                }
            }
        }
        return Optional.empty();
    }

    public Optional<Voter> findByNationalId(String nationalId) throws SQLException {
        String sql = "SELECT * FROM voter WHERE national_id = ?";
        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, nationalId);     // user input → DATA, never SQL
            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    return Optional.of(mapRow(rs));
                }
            }
        }
        return Optional.empty();
    }

    public Optional<Voter> findByEmail(String email) throws SQLException {
        String sql = "SELECT * FROM voter WHERE email = ?";
        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, email);
            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    return Optional.of(mapRow(rs));
                }
            }
        }
        return Optional.empty();
    }

    public List<Voter> findAll() throws SQLException {
        String sql = "SELECT * FROM voter ORDER BY full_name";
        List<Voter> list = new ArrayList<>();
        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                list.add(mapRow(rs));
            }
        }
        return list;
    }

    public List<Voter> findByStatus(VoterStatus status) throws SQLException {
        String sql = "SELECT * FROM voter WHERE status = ? ORDER BY full_name";
        List<Voter> list = new ArrayList<>();
        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, status.name());
            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    list.add(mapRow(rs));
                }
            }
        }
        return list;
    }

    // ── UPDATE ────────────────────────────────────────────────────────────────

    public boolean updatePassword(int voterId, String newPassword) throws SQLException {
        String sql = "UPDATE voter SET password = ?, updated_at = NOW() WHERE voter_id = ?";
        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, newPassword);
            ps.setInt(2, voterId);
            return ps.executeUpdate() > 0;
        }
    }

    public boolean updateStatus(int voterId, VoterStatus newStatus) throws SQLException {
        String sql = "UPDATE voter SET status = ?, updated_at = NOW() WHERE voter_id = ?";
        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, newStatus.name());
            ps.setInt(2, voterId);
            return ps.executeUpdate() > 0;
        }
    }

    public boolean update(Voter voter) throws SQLException {
        String sql = """
                UPDATE voter
                SET national_id = ?, full_name = ?, email = ?, status = ?, updated_at = NOW()
                WHERE voter_id = ?
                """;
        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, voter.getNationalId());
            ps.setString(2, voter.getFullName());
            ps.setString(3, voter.getEmail());
            ps.setString(4, voter.getStatus().name());
            ps.setInt(5, voter.getVoterId());
            return ps.executeUpdate() > 0;
        }
    }

    // ── DELETE ────────────────────────────────────────────────────────────────

    public boolean delete(int voterId) throws SQLException {
        String sql = "DELETE FROM voter WHERE voter_id = ?";
        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, voterId);
            return ps.executeUpdate() > 0;
        }
    }

    // ── HELPER ───────────────────────────────────────────────────────────────

    /** Maps a ResultSet row to a Voter object using column names (not index). */
    private Voter mapRow(ResultSet rs) throws SQLException {
        Voter v = new Voter();
        v.setVoterId(rs.getInt("voter_id"));
        v.setNationalId(rs.getString("national_id"));
        v.setFullName(rs.getString("full_name"));
        v.setEmail(rs.getString("email"));
        v.setStatus(VoterStatus.valueOf(rs.getString("status")));
        v.setPassword(rs.getString("password"));
        return v;
    }
}
