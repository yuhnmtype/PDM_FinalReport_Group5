package com.evoting.ui;

import com.evoting.dao.AuditLogDAO;
import com.evoting.dao.VoterDAO;
import com.evoting.enums.ActionType;

import javax.swing.*;
import java.awt.*;

/**
 * Change Password screen.
 * Accessible from ElectionListPanel via "Change Password" button.
 */
public class ChangePasswordPanel extends JPanel {

    private final MainFrame   frame;
    private final VoterDAO    voterDAO    = new VoterDAO();
    private final AuditLogDAO auditLogDAO = new AuditLogDAO();

    private final JPasswordField pfOldPassword     = new JPasswordField(20);
    private final JPasswordField pfNewPassword     = new JPasswordField(20);
    private final JPasswordField pfConfirmPassword = new JPasswordField(20);
    private final JButton        btnSave           = new JButton("Save");
    private final JButton        btnBack           = new JButton("Back");
    private final JLabel         lblStatus         = new JLabel(" ");

    public ChangePasswordPanel(MainFrame frame) {
        this.frame = frame;
        setLayout(new GridBagLayout());
        buildUI();
        wireEvents();
    }

    private void buildUI() {
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(8, 8, 8, 8);
        gbc.fill   = GridBagConstraints.HORIZONTAL;

        // Title
        JLabel title = new JLabel("Change Password", SwingConstants.CENTER);
        title.setFont(new Font("SansSerif", Font.BOLD, 20));
        gbc.gridx = 0; gbc.gridy = 0; gbc.gridwidth = 2;
        add(title, gbc);

        // Old password
        gbc.gridwidth = 1; gbc.gridy = 1; gbc.gridx = 0;
        add(new JLabel("Current Password:"), gbc);
        gbc.gridx = 1;
        add(pfOldPassword, gbc);

        // New password
        gbc.gridy = 2; gbc.gridx = 0;
        add(new JLabel("New Password:"), gbc);
        gbc.gridx = 1;
        add(pfNewPassword, gbc);

        // Confirm new password
        gbc.gridy = 3; gbc.gridx = 0;
        add(new JLabel("Confirm New Password:"), gbc);
        gbc.gridx = 1;
        add(pfConfirmPassword, gbc);

        // Status label
        lblStatus.setForeground(Color.RED);
        gbc.gridy = 4; gbc.gridx = 0; gbc.gridwidth = 2;
        add(lblStatus, gbc);

        // Buttons
        JPanel btnPanel = new JPanel(new FlowLayout());
        btnPanel.add(btnBack);
        btnPanel.add(btnSave);
        gbc.gridy = 5;
        add(btnPanel, gbc);
    }

    private void wireEvents() {
        btnBack.addActionListener(e -> {
            clearFields();
            frame.showCard(MainFrame.CARD_ELECTIONS);
        });

        btnSave.addActionListener(e -> doChangePassword());
        pfConfirmPassword.addActionListener(e -> doChangePassword()); // Enter key
    }

    private void doChangePassword() {
        String oldPassword     = new String(pfOldPassword.getPassword()).trim();
        String newPassword     = new String(pfNewPassword.getPassword()).trim();
        String confirmPassword = new String(pfConfirmPassword.getPassword()).trim();

        // Validate input
        if (oldPassword.isEmpty() || newPassword.isEmpty() || confirmPassword.isEmpty()) {
            lblStatus.setText("Please fill in all fields.");
            return;
        }
        if (newPassword.length() < 6) {
            lblStatus.setText("New password must be at least 6 characters.");
            return;
        }
        if (!newPassword.equals(confirmPassword)) {
            lblStatus.setText("New passwords do not match.");
            pfNewPassword.setText("");
            pfConfirmPassword.setText("");
            return;
        }
        if (newPassword.equals(oldPassword)) {
            lblStatus.setText("New password must be different from current password.");
            return;
        }

        btnSave.setEnabled(false);
        lblStatus.setText(" ");
        int voterId = frame.getCurrentVoterId();

        SwingWorker<Void, Void> worker = new SwingWorker<>() {
            private String errorMessage = null;

            @Override
            protected Void doInBackground() throws Exception {
                // Verify old password matches DB
                var voterOpt = voterDAO.findById(voterId);
                if (voterOpt.isEmpty()) {
                    errorMessage = "Voter not found.";
                    return null;
                }

                String storedPassword = voterOpt.get().getPassword();
                if (!oldPassword.equals(storedPassword)) {
                    errorMessage = "Current password is incorrect.";
                    return null;
                }

                // Update to new password
                boolean updated = voterDAO.updatePassword(voterId, newPassword);
                if (!updated) {
                    errorMessage = "Failed to update password. Please try again.";
                    return null;
                }

                auditLogDAO.log(voterId, ActionType.PASSWORD_CHANGED, "Password changed via UI");
                return null;
            }

            @Override
            protected void done() {
                btnSave.setEnabled(true);
                try {
                    get();
                    if (errorMessage != null) {
                        lblStatus.setText(errorMessage);
                        if (errorMessage.contains("incorrect")) {
                            pfOldPassword.setText("");
                        }
                    } else {
                        clearFields();
                        JOptionPane.showMessageDialog(ChangePasswordPanel.this,
                                "Password changed successfully!");
                        frame.showCard(MainFrame.CARD_ELECTIONS);
                    }
                } catch (Exception ex) {
                    lblStatus.setText("Database error: " + ex.getMessage());
                }
            }
        };
        worker.execute();
    }

    /** Clears all fields — called when navigating away. */
    public void clearFields() {
        pfOldPassword.setText("");
        pfNewPassword.setText("");
        pfConfirmPassword.setText("");
        lblStatus.setText(" ");
    }
}
